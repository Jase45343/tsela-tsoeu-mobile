{
  "name": "@busledger/server",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.js --packages=external --alias:@busledger/core=../../packages/core/src/index.ts && cp -r migrations dist/",
    "migrate": "tsx src/migrate-cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@busledger/core": "1.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^10.0.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0"
  }
}
